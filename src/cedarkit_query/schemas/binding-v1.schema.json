{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:binding:v1",
  "title": "CedarKit binding v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.binding/v1"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "local",
        "cmadaas"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resolver": {
              "const": "file-pattern"
            },
            "root": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "resolver",
            "root",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resolver": {
              "const": "reki-local"
            },
            "data_type": {
              "type": "string",
              "minLength": 1
            },
            "config_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "resolver",
            "data_type",
            "config_version"
          ],
          "additionalProperties": false
        }
      ]
    },
    "data_code": {
      "type": "string",
      "minLength": 1
    },
    "request_kind": {
      "const": "model_grid"
    },
    "origin": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "api_version",
    "dataset",
    "kind",
    "source_id",
    "catalog_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "local"
          }
        }
      },
      "then": {
        "required": [
          "locator"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "data_code"
              ]
            },
            {
              "required": [
                "request_kind"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "data_code",
          "request_kind"
        ],
        "not": {
          "required": [
            "locator"
          ]
        }
      }
    }
  ]
}
