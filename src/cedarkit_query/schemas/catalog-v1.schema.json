{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:catalog:v1",
  "title": "CedarKit catalog v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.catalog/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "member_roles": {
            "$ref": "urn:cedarkit:query:common:v1#/$defs/member_roles"
          },
          "execution": {
            "$ref": "urn:cedarkit:query:common:v1#/$defs/execution"
          },
          "local_layout": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "api_version",
    "id",
    "version",
    "datasets"
  ],
  "additionalProperties": false
}
