{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:transform:v1",
  "title": "CedarKit transform v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.transform/v1"
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "crop"
              },
              "bbox": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "kind",
              "bbox"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "unit"
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "api_version",
    "operations"
  ],
  "additionalProperties": false
}
