{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:query:v1",
  "title": "CedarKit query v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.query/v1"
    },
    "domain": {
      "const": "grid"
    },
    "dataset": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "namespace",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "oneOf": [
        {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "namespace",
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "namespace",
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        }
      ]
    },
    "reference_time": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "stop": {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "step": {
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
                  "not": {
                    "enum": [
                      "P",
                      "PT"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "^P(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$"
                  }
                }
              ]
            },
            "closed": {
              "enum": [
                "both",
                "left",
                "right",
                "neither"
              ]
            }
          },
          "required": [
            "start",
            "stop",
            "step",
            "closed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "lead_time": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
          "not": {
            "enum": [
              "P",
              "PT"
            ]
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
            "not": {
              "enum": [
                "P",
                "PT"
              ]
            }
          },
          "minItems": 1
        },
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
              "not": {
                "enum": [
                  "P",
                  "PT"
                ]
              }
            },
            "stop": {
              "type": "string",
              "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
              "not": {
                "enum": [
                  "P",
                  "PT"
                ]
              }
            },
            "step": {
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
                  "not": {
                    "enum": [
                      "P",
                      "PT"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "^P(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$"
                  }
                }
              ]
            },
            "closed": {
              "enum": [
                "both",
                "left",
                "right",
                "neither"
              ]
            }
          },
          "required": [
            "start",
            "stop",
            "step",
            "closed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "valid_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "vertical": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "surface",
            "isobaric",
            "heightAboveGround",
            "soilLayer",
            "modelLevel"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number"
                },
                "stop": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                },
                "closed": {
                  "enum": [
                    "both",
                    "left",
                    "right",
                    "neither"
                  ]
                }
              },
              "required": [
                "start",
                "stop",
                "step",
                "closed"
              ],
              "additionalProperties": false
            }
          ]
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            },
            "required": [
              "lower",
              "upper"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "surface"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "values"
                  ]
                },
                {
                  "required": [
                    "bounds"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "surface"
                }
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ],
            "oneOf": [
              {
                "required": [
                  "values"
                ],
                "not": {
                  "required": [
                    "bounds"
                  ]
                }
              },
              {
                "required": [
                  "bounds"
                ],
                "not": {
                  "required": [
                    "values"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "statistic": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "instant",
            "accum",
            "mean",
            "min",
            "max"
          ]
        },
        "window": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
              "not": {
                "enum": [
                  "P",
                  "PT"
                ]
              }
            },
            {
              "not": {
                "pattern": "^P(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$"
              }
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instant"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "window"
              ]
            }
          },
          "else": {
            "required": [
              "window"
            ]
          }
        }
      ]
    },
    "member": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "enum": [
                "control",
                "perturbation"
              ]
            }
          },
          "required": [
            "id",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "control",
                  "perturbation"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      ]
    },
    "native_grid": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "crs": {
          "const": "EPSG:4326"
        },
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "relation": {
          "const": "intersects"
        }
      },
      "required": [
        "crs",
        "bbox",
        "relation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "domain",
    "dataset"
  ],
  "additionalProperties": false
}
