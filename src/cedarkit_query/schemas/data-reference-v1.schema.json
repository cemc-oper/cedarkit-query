{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:data-reference:v1",
  "title": "CedarKit data-reference v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.data-reference/v1"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "field_identity": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "reference_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "lead_time": {
          "type": "string",
          "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
          "not": {
            "enum": [
              "P",
              "PT"
            ]
          }
        },
        "vertical": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "surface",
                "isobaric",
                "heightAboveGround",
                "soilLayer",
                "modelLevel"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number"
                    },
                    "stop": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number"
                    },
                    "closed": {
                      "enum": [
                        "both",
                        "left",
                        "right",
                        "neither"
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "stop",
                    "step",
                    "closed"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "bounds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  }
                },
                "required": [
                  "lower",
                  "upper"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "surface"
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "values"
                      ]
                    },
                    {
                      "required": [
                        "bounds"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "not": {
                      "const": "surface"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "unit"
                ],
                "oneOf": [
                  {
                    "required": [
                      "values"
                    ],
                    "not": {
                      "required": [
                        "bounds"
                      ]
                    }
                  },
                  {
                    "required": [
                      "bounds"
                    ],
                    "not": {
                      "required": [
                        "values"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        "statistic": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "instant",
                "accum",
                "mean",
                "min",
                "max"
              ]
            },
            "window": {
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
                  "not": {
                    "enum": [
                      "P",
                      "PT"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "^P(?:0+D)?(?:T(?:0+H)?(?:0+M)?(?:0+S)?)?$"
                  }
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "instant"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "window"
                  ]
                }
              },
              "else": {
                "required": [
                  "window"
                ]
              }
            }
          ]
        },
        "member": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "enum": [
                "control",
                "perturbation"
              ]
            }
          },
          "required": [
            "id",
            "role"
          ],
          "additionalProperties": false
        },
        "native_grid": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "parameter",
        "reference_time",
        "lead_time"
      ],
      "additionalProperties": false
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtime_ns": {
                  "type": "integer",
                  "minimum": 0
                },
                "device": {
                  "type": "integer",
                  "minimum": 0
                },
                "inode": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "size",
                "mtime_ns",
                "device",
                "inode"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "locator",
            "fingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cmadaas"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "locator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "verification": {
      "enum": [
        "path_exists",
        "field_confirmed",
        "remote_unverified"
      ]
    },
    "field_locator": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "field_index": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "vocabulary_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "api_version",
    "dataset",
    "field_identity",
    "binding_id",
    "resource",
    "verification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "const": "field_confirmed"
          }
        }
      },
      "then": {
        "required": [
          "field_locator"
        ]
      },
      "else": {
        "not": {
          "required": [
            "field_locator"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {
                "const": "cmadaas"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "const": "remote_unverified"
          }
        }
      }
    }
  ]
}
