{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:error:v1",
  "title": "CedarKit error v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.error/v1"
    },
    "code": {
      "enum": [
        "invalid_request",
        "unsupported_version",
        "invalid_config",
        "invalid_query",
        "constraint_conflict",
        "unsupported",
        "expansion_limit_exceeded",
        "no_match",
        "multiple_matches",
        "missing_fields",
        "completeness_undetermined",
        "duplicate_field",
        "incompatible_grid",
        "multiple_variables",
        "resource_not_found",
        "permission_denied",
        "authentication_failed",
        "timeout",
        "decode_failed",
        "io_error",
        "service_error",
        "metadata_interpretation_failed",
        "incomplete_response"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "context": {
      "type": "object"
    },
    "report": {
      "$ref": "urn:cedarkit:query:report:v1"
    }
  },
  "required": [
    "api_version",
    "code",
    "path",
    "message",
    "context"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "missing_fields",
              "completeness_undetermined"
            ]
          }
        }
      },
      "then": {
        "required": [
          "report"
        ]
      },
      "else": {
        "not": {
          "required": [
            "report"
          ]
        }
      }
    }
  ]
}
