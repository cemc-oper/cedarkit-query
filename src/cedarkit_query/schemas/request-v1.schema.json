{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:request:v1",
  "title": "CedarKit request v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.request/v1"
    },
    "action": {
      "enum": [
        "validate",
        "plan",
        "list",
        "locate",
        "read"
      ]
    },
    "query": {
      "$ref": "urn:cedarkit:query:query:v1"
    },
    "policy": {
      "type": "object",
      "properties": {
        "cardinality": {
          "enum": [
            "one",
            "zero_or_one",
            "all"
          ]
        },
        "missing": {
          "enum": [
            "error",
            "partial"
          ]
        },
        "duplicates": {
          "const": "error"
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cardinality": {
                "const": "zero_or_one"
              }
            },
            "required": [
              "cardinality"
            ]
          },
          "then": {
            "properties": {
              "missing": {
                "const": "partial"
              }
            },
            "required": [
              "missing"
            ]
          }
        }
      ]
    },
    "transforms": {
      "$ref": "urn:cedarkit:query:transform:v1"
    },
    "options": {
      "type": "object",
      "properties": {
        "max_expansion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "const": "netcdf"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "action",
    "query"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "plan",
              "locate",
              "read"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "query": {
            "required": [
              "parameter",
              "reference_time",
              "lead_time"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "read"
            }
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "not": {
              "required": [
                "output"
              ]
            }
          }
        }
      }
    }
  ]
}
