{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cedarkit:query:request:v1",
  "title": "CedarKit request v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "cedarkit.request/v1"
    },
    "source": {
      "$ref": "urn:cedarkit:query:common:v1#/$defs/source"
    },
    "context": {
      "oneOf": [
        {
          "$ref": "urn:cedarkit:query:common:v1#/$defs/context"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "urn:cedarkit:query:common:v1#/$defs/query"
      },
      "minItems": 1
    },
    "completeness": {
      "enum": [
        "available",
        "required"
      ]
    }
  },
  "required": [
    "api_version",
    "source",
    "queries"
  ],
  "additionalProperties": false
}
